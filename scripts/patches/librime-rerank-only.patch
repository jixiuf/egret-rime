+// 实验补丁 (egret): 用含 LM 的整句得分给一条 line 打分（供 rerank_only 用）。
+static double ScoreLineWithGrammar(const Line& line,
+                                   Grammar* grammar,
+                                   const string& preceding_text) {
+  if (!grammar)
+    return line.weight;
+  // 注意：必须先绑定 components() 的返回值。若写成
+  //   vector<const Line*> v(line.components().begin(), line.components().end());
+  // 两次调用会生成两个不同的临时对象，begin/end 属于不同容器 → UB
+  // （实测：std::length_error: cannot create std::vector larger than max_size()）
+  auto comps_obj = line.components();
+  vector<const Line*> comps(comps_obj.begin(), comps_obj.end());
+  double score = 0.0;
+  string w1, w2;  // w1 = 上一个词, w2 = 上上个词
+  bool first = true;
+  for (size_t i = 0; i < comps.size(); ++i) {
+    const DictEntry* e = comps[i]->entry;
+    if (!e)
+      continue;
+    const string context = first ? preceding_text : w2 + w1;
+    const bool is_rear = (i + 1 == comps.size());
+    score += Grammar::Evaluate(context, e->text, e->weight, is_rear, grammar);
+    w2 = w1;
+    w1 = e->text;
+    first = false;
+  }
+  return score;
+}
