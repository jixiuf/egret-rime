+-- ----------------------------------------------------------------
+-- 读法判定（mix_segmentor 用）：确定性纯权重 DP，**不跑 LM**，且**增量**。
+--
+-- 为什么换掉 beam：旧路径为了判「整串算五笔还是拼音」，对**每个前缀**都跑一次
+-- beam search，而 beam 在每个位置都要把 by_key[2字前缀]（平均 406 条、最多 4766 条）
+-- 全量扫一遍 → 52 字母输入光搜索器就 52 s（每键约 1 s）。
+-- 判定其实只需要「最优覆盖路径的段读法」，是个标准最短路：
+--   w(段) = 词权重 - LOG_N（与旧打分项一致），dp[j] = max(dp[i-1] + w)
+-- 用**精确码二分**取候选（每位置最多 MAXL 次查找），并把 dp 前向数组按输入前缀缓存，
+-- 于是每键只需补算新增的那一个位置。
+local MAX_CODE_LEN = 15      -- 与 compose_table 的最大码长一致（jiangshangzhang）
+local cls = { input = "", score = { [0] = 0 }, from = {} }
+
+local function cls_reset()
+    cls.input = ""
+    cls.score = { [0] = 0 }
+    cls.from = {}
+end
+
+--- 判整串读法：全五笔 -> "wubi"，全拼音 -> "py"，混合/单段/不可覆盖 -> nil。
+-- 语义与原先「取最优路径的段读法 + 至少 2 段」完全一致，只是换成精确最优解。
+function M.classify(input)
+    if not pack or not input or #input < 2 then return nil end
+    if cls.input == "" or input:sub(1, #cls.input) ~= cls.input then cls_reset() end
+    for j = #cls.input + 1, #input do
+        local best, bf
+        for L = 1, math.min(MAX_CODE_LEN, j) do
+            local i = j - L + 1
+            local s = cls.score[i - 1]
+            if s then
+                local ents = pack_exact(input:sub(i, j))
+                if ents then
+                    for _, e in ipairs(ents) do
+                        local v = s + (e.weight - LOG_N)
+                        if not best or v > best then
+                            best, bf = v, { prev = i - 1, kind = e.kind }
+                        end
+                    end
+                end
+            end
+        end
+        cls.score[j] = best
+        cls.from[j] = bf
+    end
+    cls.input = input
+    if not cls.score[#input] then return nil end
+    local all_wubi, all_py, npieces, j = true, true, 0, #input
+    while j and j > 0 do
+        local f = cls.from[j]
+        if not f then return nil end
+        npieces = npieces + 1
+        if f.kind ~= "wubi" then all_wubi = false end
+        if f.kind ~= "pinyin" then all_py = false end
+        j = f.prev
+    end
+    if npieces < 2 then return nil end
+    if all_wubi then return "wubi" end
+    if all_py then return "py" end
+    return nil
+end
+
