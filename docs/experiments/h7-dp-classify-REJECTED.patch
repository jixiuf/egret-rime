@@ -90,6 +90,27 @@ local function pack_prefix(key)
     return #out > 0 and out or nil
 end
 
+-- 精确码查找（二分）：DP 判定读法用。
+-- 为什么不用 by_key 前缀桶：2 字前缀平均返回 **406 条**、最多 4766 条（"ji"），
+-- 搜索器在每个位置 × 每条路径都全量扫一遍 —— 这才是长输入 1~2 s/键的真正来源。
+local function pack_exact(code)
+    if not pack then return nil end
+    local lo, hi = 0, pack.count - 1
+    while lo <= hi do
+        local mid = math.floor((lo + hi) / 2)
+        if byte_lt(rec_at(mid), code) then lo = mid + 1 else hi = mid - 1 end
+    end
+    local out
+    for i = lo, pack.count - 1 do
+        local c, kind, w = rec_at(i)
+        if c ~= code then break end
+        out = out or {}
+        out[#out + 1] = { kind = (kind == 0) and "wubi" or (kind == 1) and "pinyin" or nil,
+                          weight = w }
+    end
+    return out
+end
